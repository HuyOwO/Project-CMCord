PORT=5000
MONGODB_URI=mongodb://localhost:27017/cmcord
JWT_SECRET=your_super_secret_key_change_this
CLIENT_URL=http://localhost:5173

# Lưu trữ file đính kèm (giới hạn 8MB/file).
# - Để TRỐNG 3 dòng dưới -> file được lưu ở server/uploads/ (chỉ hợp cho chạy local,
#   vì đa số hosting free có ổ đĩa tạm thời, file sẽ mất khi redeploy).
# - Điền đủ 3 dòng dưới -> file được lưu lên Cloudinary (free, không cần thẻ tín dụng),
#   dùng khi deploy thật. Lấy 3 giá trị này tại: Cloudinary Dashboard -> Product Environment
#   (đăng ký free tại https://cloudinary.com/users/register/free).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
